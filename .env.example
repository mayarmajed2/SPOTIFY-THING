# ============================================================================
# SPOTIFY-THING — Environment Configuration Template (.env.example)
# Copy to `.env` for local customization. Never commit real secrets or tokens.
# ============================================================================

# --- FastAPI Backend & Persistence ---
PROCESSED_DIR=data/processed
ARTIFACTS_DIR=data/artifacts
REPORTS_DIR=data/reports
RESONANCE_FEEDBACK_DB=data/artifacts/feedback_state.db
RESONANCE_EXTENSION_DB=data/artifacts/extension_state.db

# --- CORS Security ---
# Comma-separated web origins allowed to call the FastAPI server
RESONANCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allow Chrome Extension (`chrome-extension://<32-char-id>`) & Vite preview (`localhost:5173`)
RESONANCE_ALLOW_EXTENSION_CORS=true
# Optional: lock production deployments to a single published Chrome Extension ID
RESONANCE_CHROME_EXTENSION_ID=

# --- Optional Spotify OAuth 2.0 (PKCE) ---
# IMPORTANT: Do NOT set or embed a Spotify Client Secret.
# Users configure their public Spotify Developer Client ID directly in the Chrome Extension Settings UI.
